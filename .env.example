# ════════════════════════════════════════════════════════
#  AskariServer — Configuration
#  Copier ce fichier en .env et adapter les valeurs
# ════════════════════════════════════════════════════════

# ── Sécurité (OBLIGATOIRE — changer en production) ──────
SECRET_KEY=generez-une-cle-aleatoire-longue-ici-min-32-chars

# ── Serveur ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=7777

# ── Musique ───────────────────────────────────────────────
# Dossier(s) à scanner — séparer par : pour plusieurs dossiers
MUSIC_DIRS=/music:/music2

# Scan automatique au démarrage
AUTO_SCAN_ON_START=true

# Re-scan toutes les N heures (0 = désactivé)
SCAN_INTERVAL_HOURS=24

# ── Base de données ───────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////data/askari.db

# ── Cache ─────────────────────────────────────────────────
CACHE_DIR=/data/cache

# ── Transcoding ───────────────────────────────────────────
TRANSCODING_ENABLED=true
FFMPEG_PATH=ffmpeg
DEFAULT_QUALITY=high

# ── Utilisateurs ──────────────────────────────────────────
# false = inscription par invitation admin uniquement
ALLOW_REGISTRATION=false
MAX_USERS=10

# ── Authentification ──────────────────────────────────────
# Migration vers login par email uniquement :
#
#  Phase 1 (maintenant) : false — accepte username OU email
#    Les users sans email peuvent encore se connecter par username.
#    Demandez-leur d'ajouter leur email depuis leur profil.
#
#  Phase 2 (quand tous ont un email) :
#    1. Vérifier : GET /auth/users/no-email  (endpoint admin)
#    2. Lancer la migration BDD : alembic upgrade 003_require_email
#    3. Passer ce flag à true et redémarrer le serveur
#
REQUIRE_EMAIL_LOGIN=false

# ── Accès externe ─────────────────────────────────────────
# true si derrière Nginx / reverse proxy
TRUST_PROXY_HEADERS=true
